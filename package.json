{
  "name": "access-agent-eval",
  "version": "0.1.0",
  "description": "Reliability & anomaly evaluation harness for autonomous access-management agents",
  "type": "module",
  "bin": {
    "access-agent-eval": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "start": "tsx src/cli.ts",
    "run:eval": "tsx src/cli.ts run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["mcp", "agent", "evaluation", "access-management", "reliability"],
  "license": "MIT",
  "dependencies": {
    "langfuse": "^3.29.0",
    "openai": "^5.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=20" }
}
